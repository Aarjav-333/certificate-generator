# Copy to .env.local for local development (never commit real values).

# Required for the certificate API. Callers send it as
#   Authorization: Bearer <key>
# Several keys may be given, comma-separated, to rotate without downtime.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CERTIFICATE_API_KEY=

# Optional: certificates (rate-limit units) per minute per API key, per function instance. Default 60.
CERTIFICATE_API_RATE_LIMIT=

# Optional: comma-separated browser origins allowed to call the API cross-origin (CORS),
# e.g. https://events.example.edu. Leave empty for server-to-server use (recommended).
CERTIFICATE_API_CORS_ORIGINS=
